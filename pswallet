#!/usr/bin/env python3
"""
pswallet - PiSecure Wallet CLI
================================

Complete wallet management and blockchain interaction tool for PiSecure.
"""

import sys, os, json, time, secrets, click
from pathlib import Path
from rich.console import Console
from rich.table import Table
from rich.progress import Progress, SpinnerColumn, TextColumn

console = Console()

# Import PiSecure components
try:
    from pisecure.core import SignChain
    from pisecure.core.wallet import SignWallet
except ImportError:
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        from pisecure.core import SignChain
        from pisecure.core.wallet import SignWallet
    except ImportError:
        console.print("[red]Error: Could not import PiSecure[/red]")
        sys.exit(1)


def get_wallet_dir(testnet=False, custom_dir=None):
    """Get wallet directory"""
    if custom_dir:
        return custom_dir
    if testnet or os.environ.get("PISECURE_TESTNET") == "1":
        system_dir = "/var/lib/pisecure-testnet/wallets"
    else:
        system_dir = "/var/lib/pisecure/wallets"
    if os.path.exists(os.path.dirname(system_dir)):
        return system_dir
    local_dir = os.path.expanduser("~/.pisecure/wallets")
    if testnet or os.environ.get("PISECURE_TESTNET") == "1":
        local_dir = os.path.expanduser("~/.pisecure-testnet/wallets")
    return local_dir


def get_blockchain(testnet=False):
    """Get blockchain instance"""
    if testnet or os.environ.get("PISECURE_TESTNET") == "1":
        os.environ["PISECURE_TESTNET"] = "1"
    return SignChain()


@click.group()
@click.option("--testnet", is_flag=True)
@click.option("--json", "output_json", is_flag=True)
@click.option("--wallet-dir")
@click.option("--quiet", is_flag=True)
@click.pass_context
def cli(ctx, testnet, output_json, wallet_dir, quiet):
    """pswallet - PiSecure Wallet Manager"""
    ctx.ensure_object(dict)
    ctx.obj["testnet"] = testnet
    ctx.obj["json"] = output_json
    ctx.obj["wallet_dir"] = wallet_dir
    ctx.obj["quiet"] = quiet
    if testnet and not quiet:
        console.print("[dim]Using testnet[/dim]")
    if testnet:
        os.environ["PISECURE_TESTNET"] = "1"


# Wallet commands
@cli.command()
@click.argument("name")
@click.option("--display-name")
@click.pass_context
def create(ctx, name, display_name):
    """Create new wallet"""
    wallet_dir = get_wallet_dir(ctx.obj["testnet"], ctx.obj.get("wallet_dir"))
    os.makedirs(wallet_dir, exist_ok=True)
    wallet = SignWallet(os.path.join(wallet_dir, "wallets.json"))
    result = wallet.create_wallet(name, display_name or name)
    if ctx.obj["json"]:
        print(json.dumps(result, indent=2))
    elif result.get("success"):
        console.print(f"[green]✅ Created: {name}[/green]")
        console.print(f"[cyan]{result.get('address')}[/cyan]")
    else:
        console.print(f"[red]❌ {result.get('error')}[/red]")
        sys.exit(1)


@cli.command()
@click.pass_context
def list(ctx):
    """List all wallets"""
    wallet_dir = get_wallet_dir(ctx.obj["testnet"], ctx.obj.get("wallet_dir"))
    wallet_file = os.path.join(wallet_dir, "wallets.json")
    if not os.path.exists(wallet_file):
        console.print("[yellow]No wallets[/yellow]")
        return
    wallet = SignWallet(wallet_file)
    wallets = wallet.list_wallets()
    if ctx.obj["json"]:
        print(json.dumps(wallets, indent=2))
    elif not wallets:
        console.print("[yellow]No wallets[/yellow]")
    else:
        table = Table(title="💰 Wallets")
        table.add_column("Name", style="cyan")
        table.add_column("Address", style="green")
        table.add_column("Balance", style="yellow", justify="right")
        for w in wallets:
            addr = w.get("address", "")
            table.add_row(
                w.get("name", "unknown"),
                addr[:12] + "..." + addr[-8:] if len(addr) > 20 else addr,
                f"{w.get('balance', 0):.2f}",
            )
        console.print(table)


@cli.command()
@click.argument("address")
@click.pass_context
def balance(ctx, address):
    """Check balance from blockchain"""
    blockchain = get_blockchain(ctx.obj["testnet"])
    balance = blockchain.get_wallet_balance(address)
    if ctx.obj["json"]:
        print(json.dumps({"address": address, "balance": balance}))
    else:
        console.print(f"[green]{balance:.2f} 314ST[/green]")


# Transaction commands
@cli.command()
@click.argument("address")
@click.option("--limit", default=20)
@click.pass_context
def history(ctx, address, limit):
    """Show transaction history"""
    blockchain = get_blockchain(ctx.obj["testnet"])
    txs = blockchain.get_wallet_transactions(address)
    if limit and len(txs) > limit:
        txs = txs[-limit:]  # Get last N transactions
    if ctx.obj["json"]:
        print(json.dumps(txs, indent=2, default=str))
    elif not txs:
        console.print("[yellow]No transactions[/yellow]")
    else:
        table = Table(title=f"📜 History ({len(txs)} tx)")
        table.add_column("Type")
        table.add_column("From")
        table.add_column("To")
        table.add_column("Amount", justify="right")
        for tx in txs:
            table.add_row(
                tx.get("type", "?")[:15],
                (tx.get("from", "N/A")[:8] + "...") if tx.get("from") else "N/A",
                (tx.get("to", "N/A")[:8] + "...") if tx.get("to") else "N/A",
                f"{tx.get('amount', 0):.2f}" if tx.get("amount") else "-",
            )
        console.print(table)


@cli.command()
@click.argument("wallet_id")
@click.argument("recipient")
@click.argument("amount", type=float)
@click.option("--memo", default="")
@click.pass_context
def send(ctx, wallet_id, recipient, amount, memo):
    """Send tokens from wallet to recipient"""
    wallet_dir = get_wallet_dir(ctx.obj["testnet"], ctx.obj.get("wallet_dir"))

    try:
        # Create wallet manager and load wallet with private key
        wallet_manager = SignWallet(os.path.join(wallet_dir, "wallets.json"))
        wallet_data = wallet_manager.load_wallet(wallet_id)

        if "error" in wallet_data:
            console.print(f"[red]❌ {wallet_data['error']}[/red]")
            sys.exit(1)

        if "private_key" not in wallet_data:
            console.print(
                f"[red]❌ Private key not found for wallet '{wallet_id}'[/red]"
            )
            sys.exit(1)

        # Get balance
        blockchain = get_blockchain(ctx.obj["testnet"])
        sender_addr = wallet_data["address"]
        balance = blockchain.get_wallet_balance(sender_addr)

        # Calculate transaction fee
        fee = blockchain._calculate_transaction_fee(amount, "token_transfer")
        total_cost = amount + fee

        if balance < total_cost:
            console.print(
                f"[red]❌ Insufficient balance: {balance:.2f} < {total_cost:.2f}[/red]"
            )
            console.print(f"   [dim]Amount: {amount:.2f}, Fee: {fee:.2f}[/dim]")
            sys.exit(1)

        # Create transaction
        network_id = "testnet" if ctx.obj["testnet"] else "mainnet"
        transaction = {
            "type": "token_transfer",
            "sender_address": sender_addr,
            "sender_wallet": wallet_id,
            "recipient_address": recipient,
            "amount": amount,
            "memo": memo,
            "timestamp": time.time(),
            "nonce": secrets.token_hex(8),
            "network_id": network_id,
        }

        # Sign transaction
        private_key = wallet_data["private_key"]
        tx_copy = transaction.copy()
        tx_string = json.dumps(tx_copy, sort_keys=True)

        from cryptography.hazmat.primitives import hashes
        from cryptography.hazmat.primitives.asymmetric import padding

        signature = private_key.sign(
            tx_string.encode(),
            padding.PSS(
                mgf=padding.MGF1(hashes.SHA256()), salt_length=padding.PSS.MAX_LENGTH
            ),
            hashes.SHA256(),
        )

        transaction["signature"] = signature.hex()

        # Submit to blockchain
        tx_hash = blockchain.add_transaction(transaction)

        if ctx.obj["json"]:
            print(
                json.dumps(
                    {"success": True, "tx_hash": tx_hash, "amount": amount, "fee": fee}
                )
            )
        else:
            console.print(f"[green]✅ Transfer submitted[/green]")
            console.print(f"   Amount: {amount:.2f} 314ST")
            console.print(f"   Fee: {fee:.2f} 314ST")
            console.print(f"   Total Cost: {total_cost:.2f} 314ST")
            console.print(f"   To: {recipient[:20]}...")
            console.print(f"   TX: {tx_hash[:20]}...")
            console.print(f"   [dim]Status: Pending (mine to confirm)[/dim]")

    except Exception as e:
        console.print(f"[red]❌ Error: {e}[/red]")
        sys.exit(1)


@cli.command("create-tx")
@click.option("--count", default=5)
@click.pass_context
def create_tx(ctx, count):
    """Create test transactions"""
    blockchain = get_blockchain(ctx.obj["testnet"])
    for i in range(count):
        tx = {
            "type": "test",
            "data": {"id": secrets.token_hex(8)},
            "signature": f"sig_{secrets.token_hex(4)}",
            "timestamp": time.time(),
        }
        blockchain.add_transaction(tx)
    console.print(f"[green]✅ Created {count} transactions[/green]")


