# Blockchain queries
@cli.command()
@click.argument("number", type=int)
@click.pass_context
def block(ctx, number):
    """Show block details"""
    blockchain = get_blockchain(ctx.obj["testnet"])
    if number < 0 or number >= len(blockchain.chain):
        console.print(f"[red]Block #{number} not found[/red]")
        sys.exit(1)
    blk = blockchain.chain[number]
    if ctx.obj["json"]:
        print(json.dumps(blk.to_dict(), indent=2, default=str))
    else:
        table = Table(title=f"🧱 Block #{blk.index}")
        table.add_column("Property", style="cyan")
        table.add_column("Value")
        table.add_row("Hash", blk.hash[:40] + "...")
        table.add_row("Previous", blk.previous_hash[:40] + "...")
        table.add_row("Timestamp", time.ctime(blk.timestamp))
        table.add_row("Transactions", str(len(blk.transactions)))
        console.print(table)


@cli.command()
@click.pass_context
def status(ctx):
    """Show blockchain status"""
    blockchain = get_blockchain(ctx.obj["testnet"])
    info = {
        "blocks": len(blockchain.chain),
        "pending": len(blockchain.pending_transactions),
        "difficulty": blockchain.difficulty,
        "valid": blockchain.validate_chain(),
    }
    if ctx.obj["json"]:
        print(json.dumps(info))
    else:
        table = Table(title="🔗 Status")
        table.add_column("Metric")
        table.add_column("Value")
        table.add_row("Blocks", str(info["blocks"]))
        table.add_row("Pending TX", str(info["pending"]))
        table.add_row("Difficulty", str(info["difficulty"]))
        table.add_row("Valid", "✅" if info["valid"] else "❌")
        console.print(table)


@cli.command()
@click.pass_context
def validate(ctx):
    """Validate blockchain"""
    blockchain = get_blockchain(ctx.obj["testnet"])
    if blockchain.validate_chain():
        console.print(f"[green]✅ Valid ({len(blockchain.chain)} blocks)[/green]")
    else:
        console.print("[red]❌ Invalid[/red]")
        sys.exit(1)


# PiNS commands
@cli.command()
@click.argument("name")
@click.pass_context
def resolve(ctx, name):
    """Resolve PiNS name"""
    if name.endswith(".pisecure"):
        name = name[:-9]
    blockchain = get_blockchain(ctx.obj["testnet"])
    if hasattr(blockchain, "name_registry") and name in blockchain.name_registry:
        record = blockchain.name_registry[name]
        if ctx.obj["json"]:
            print(json.dumps(record, indent=2, default=str))
        else:
            console.print(f"[green]{name}.pisecure → {record.get('address')}[/green]")
    else:
        console.print(f"[yellow]Not registered: {name}.pisecure[/yellow]")


# Validator commands
@cli.command("validator-rewards")
@click.argument("wallet_address", required=False)
@click.pass_context
def validator_rewards(ctx, wallet_address):
    """Check total validator rewards earned by wallet"""
    blockchain = get_blockchain(ctx.obj["testnet"])

    if wallet_address:
        rewards = blockchain.get_validation_rewards(wallet_address)
        if ctx.obj["json"]:
            print(
                json.dumps(
                    {"wallet": wallet_address, "total_rewards": rewards}, indent=2
                )
            )
        else:
            console.print(
                f"[cyan]{wallet_address}[/cyan]: [green]{rewards:.2f}[/green] 314ST"
            )
    else:
        # Show all validators
        if blockchain.validation_rewards_awarded:
            table = Table(title="Validator Rewards")
            table.add_column("Wallet Address", style="cyan")
            table.add_column("Total Rewards (314ST)", style="green", justify="right")

            for wallet, rewards in sorted(
                blockchain.validation_rewards_awarded.items(),
                key=lambda x: x[1],
                reverse=True,
            ):
                table.add_row(
                    wallet[:20] + "..." if len(wallet) > 20 else wallet,
                    f"{rewards:.2f}",
                )

            console.print(table)
        else:
            console.print("[yellow]No validator rewards earned yet[/yellow]")


@cli.command("validator-history")
@click.argument("wallet_address", required=False)
@click.option("--limit", default=20, help="Maximum rewards to show")
@click.pass_context
def validator_history(ctx, wallet_address, limit):
    """Show validator reward history"""
    blockchain = get_blockchain(ctx.obj["testnet"])

    history = blockchain.get_validator_reward_history(wallet_address)

    if not history:
        console.print("[yellow]No validator reward history[/yellow]")
        return

    if ctx.obj["json"]:
        print(json.dumps(history[-limit:], indent=2, default=str))
    else:
        table = Table(title="Validator Reward History")
        table.add_column("Block #", style="cyan", justify="right")
        table.add_column("Validator ID", style="magenta")
        table.add_column("Wallet", style="green")
        table.add_column("Amount (314ST)", justify="right", style="yellow")
        table.add_column("Time", style="dim")

        import datetime

        for reward in history[-limit:]:
            timestamp = datetime.datetime.fromtimestamp(reward["timestamp"]).strftime(
                "%Y-%m-%d %H:%M:%S"
            )
            wallet_short = (
                reward["wallet_address"][:16] + "..."
                if len(reward["wallet_address"]) > 16
                else reward["wallet_address"]
            )
            validator_short = reward["validator_node_id"][:8]

            table.add_row(
                str(reward["block_index"]),
                validator_short,
                wallet_short,
                f"{reward['amount']:.2f}",
                timestamp,
            )

        console.print(table)


@cli.command("validator-status")
@click.pass_context
def validator_status(ctx):
    """Show validator network statistics"""
    blockchain = get_blockchain(ctx.obj["testnet"])

    stats = blockchain.get_confirmed_blocks_stats()

    if ctx.obj["json"]:
        print(json.dumps(stats, indent=2))
    else:
        console.print("\n[bold]Validator Network Statistics[/bold]")
        console.print(
            f"  [cyan]Confirmed Blocks:[/cyan] {stats['total_confirmed_blocks']}"
        )
        console.print(f"  [cyan]Unique Validators:[/cyan] {stats['unique_validators']}")
        console.print(
            f"  [cyan]Total Validations:[/cyan] {stats['total_validators_across_confirmed']}"
        )

        if stats["total_confirmed_blocks"] > 0:
            avg_validators = stats["total_validators_across_confirmed"] / max(
                1, stats["total_confirmed_blocks"]
            )
            console.print(f"  [cyan]Avg Validators/Block:[/cyan] {avg_validators:.2f}")

            # Show top validators
            if stats["validator_participation"]:
                console.print("\n  [bold]Top Validators:[/bold]")
                for validator_id, count in sorted(
                    stats["validator_participation"].items(),
                    key=lambda x: x[1],
                    reverse=True,
                )[:5]:
                    console.print(f"    • {validator_id[:8]}... ({count} blocks)")

        console.print()


