@cli.command()
@click.argument('name')
@click.argument('output_file', required=False)
@click.pass_context
def export(ctx, name, output_file):
    """Export wallet to file (backup)"""
    testnet = ctx.obj['testnet']
    custom_dir = ctx.obj.get('wallet_dir')
    
    try:
        wallet_dir = get_wallet_dir(testnet, custom_dir)
        wallet = SignWallet()
        wallet_data = wallet.load_wallet(name)
        
        if 'error' in wallet_data:
            console.print(f"[red]❌ Wallet not found: {name}[/red]")
            sys.exit(1)
        
        # Default output file
        if not output_file:
            output_file = f"{name}_backup_{int(time.time())}.json"
        
        # Export (without private key for security)
        export_data = {
            'wallet_id': wallet_data.get('wallet_id'),
            'name': wallet_data.get('name'),
            'address': wallet_data.get('address'),
            'public_key': wallet_data.get('public_key'),
            'created_at': wallet_data.get('created_at'),
            'balance': wallet_data.get('balance', 0),
            'transactions': wallet_data.get('transactions', [])
        }
        
        with open(output_file, 'w') as f:
            json.dump(export_data, f, indent=2)
        
        console.print(f"[green]✅ Wallet exported to: {output_file}[/green]")
        console.print(f"[yellow]⚠️  Private keys NOT included for security[/yellow]")
        
    except Exception as e:
        console.print(f"[red]Error: {e}[/red]")
        sys.exit(1)


@cli.command()
@click.argument('backup_file')
@click.pass_context
def import_wallet(ctx, backup_file):
    """Import wallet from backup file"""
    testnet = ctx.obj['testnet']
    custom_dir = ctx.obj.get('wallet_dir')
    
    try:
        wallet_dir = get_wallet_dir(testnet, custom_dir)
        
        if not os.path.exists(backup_file):
            console.print(f"[red]❌ File not found: {backup_file}[/red]")
            sys.exit(1)
        
        with open(backup_file, 'r') as f:
            wallet_data = json.load(f)
        
        wallet_name = wallet_data.get('wallet_id')
        if not wallet_name:
            console.print("[red]❌ Invalid backup file[/red]")
            sys.exit(1)
        
        # Save to wallet directory
        os.makedirs(wallet_dir, exist_ok=True)
        wallet_file = os.path.join(wallet_dir, f"{wallet_name}.json")
        
        with open(wallet_file, 'w') as f:
            json.dump(wallet_data, f, indent=2)
        
        console.print(f"[green]✅ Wallet imported: {wallet_name}[/green]")
        console.print(f"[yellow]⚠️  Note: Private keys must be restored separately[/yellow]")
        
    except Exception as e:
        console.print(f"[red]Error: {e}[/red]")
        sys.exit(1)


if __name__ == '__main__':
    cli(obj={})
