# === PiNS (PiSecure Name Service) COMMANDS ===

@cli.command()
@click.argument('name')
@click.pass_context
def resolve(ctx, name):
    """Resolve a PiNS name to wallet address"""
    output_json = ctx.obj['json']
    
    try:
        # Remove .pisecure suffix if present
        if name.endswith('.pisecure'):
            name = name[:-9]
        
        console.print(f"[yellow]🔍 Resolving PiNS name: {name}.pisecure[/yellow]")
        console.print(f"[dim]Note: PiNS resolution requires blockchain access[/dim]")
        console.print(f"[dim]Use the full pisecure CLI for name resolution[/dim]")
        
    except Exception as e:
        console.print(f"[red]Error: {e}[/red]")
        sys.exit(1)


@cli.command()
@click.argument('name')
@click.argument('wallet_name')
@click.option('--years', default=1, help='Years to register (default: 1)')
@click.pass_context
def register(ctx, name, wallet_name, years):
    """Register a PiNS name for a wallet"""
    testnet = ctx.obj['testnet']
    output_json = ctx.obj['json']
    
    try:
        import re
        
        # Validate name format
        if not name or len(name) < 2 or len(name) > 32:
            console.print("[red]❌ Name must be 2-32 characters[/red]")
            sys.exit(1)
        
        if not re.match(r'^[a-zA-Z0-9_-]+$', name):
            console.print("[red]❌ Name can only contain letters, numbers, hyphens, and underscores[/red]")
            sys.exit(1)
        
        # Reserved names
        reserved = {'foundation', 'genesis', 'admin', 'system', 'pisecure'}
        if name.lower() in reserved:
            console.print(f"[red]❌ Name '{name}' is reserved[/red]")
            sys.exit(1)
        
        # Calculate cost
        cost = 5.0 * years
        
        console.print(f"[cyan]📝 Registering PiNS name: {name}.pisecure[/cyan]")
        console.print(f"[yellow]Wallet: {wallet_name}[/yellow]")
        console.print(f"[yellow]Duration: {years} year(s)[/yellow]")
        console.print(f"[yellow]Cost: {cost} tokens[/yellow]")
        console.print(f"[dim]Note: PiNS registration requires blockchain access[/dim]")
        console.print(f"[dim]Use: pisecure register-name {name} {wallet_name} --years {years}[/dim]")
        
    except Exception as e:
        console.print(f"[red]Error: {e}[/red]")
        sys.exit(1)


