#!/usr/bin/env python3
"""
pswallet - Simple PiSecure Wallet CLI
======================================

Standalone wallet management tool for PiSecure.
No blockchain operations - just wallet management.

Usage:
  pswallet list                          # List all wallets
  pswallet create <name>                 # Create new wallet
  pswallet show <name>                   # Show wallet details
  pswallet balance <address>             # Check balance
  pswallet export <name>                 # Export wallet (backup)
  pswallet import <file>                 # Import wallet backup
  
  PiNS (PiSecure Name Service):
  pswallet resolve <name>                # Resolve PiNS name
  pswallet register <name> <wallet>      # Register PiNS name
  pswallet names <wallet>                # List wallet's PiNS names
  
Options:
  --testnet                              # Use testnet wallets
  --json                                 # Output as JSON
"""

import sys
import os
import json
import time
import click
from pathlib import Path
from rich.console import Console
from rich.table import Table

console = Console()

# Import wallet functionality
try:
    from pisecure.core.wallet import SignWallet
except ImportError:
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        from pisecure.core.wallet import SignWallet
    except ImportError:
        console.print("[red]Error: Could not import SignWallet[/red]")
        console.print("[yellow]Make sure PiSecure is installed: pip install -e .[/yellow]")
        sys.exit(1)


def get_wallet_dir(testnet=False, custom_dir=None):
    """Get wallet directory based on network"""
    if custom_dir:
        return custom_dir
    
    # Try system directories first (on Raspberry Pi)
    if testnet or os.environ.get('PISECURE_TESTNET') == '1':
        system_dir = "/var/lib/pisecure-testnet/wallets"
    else:
        system_dir = "/var/lib/pisecure/wallets"
    
    # If system directory is accessible, use it
    try:
        if os.path.exists(os.path.dirname(system_dir)):
            return system_dir
    except (OSError, PermissionError):
        pass
    
    # Fallback to local directory for development/testing
    local_dir = os.path.expanduser("~/.pisecure/wallets")
    if testnet or os.environ.get('PISECURE_TESTNET') == '1':
        local_dir = os.path.expanduser("~/.pisecure-testnet/wallets")
    
    return local_dir


@click.group()
@click.option('--testnet', is_flag=True, help='Use testnet network')
@click.option('--json', 'output_json', is_flag=True, help='Output as JSON')
@click.option('--wallet-dir', help='Custom wallet directory (default: /var/lib/pisecure/wallets)')
@click.pass_context
def cli(ctx, testnet, output_json, wallet_dir):
    """pswallet - Simple PiSecure Wallet Manager"""
    ctx.ensure_object(dict)
    ctx.obj['testnet'] = testnet
    ctx.obj['json'] = output_json
    ctx.obj['wallet_dir'] = wallet_dir
    
    if testnet:
        console.print("[dim]Using testnet wallets[/dim]")


@cli.command()
@click.pass_context
def list(ctx):
    """List all wallets"""
    testnet = ctx.obj['testnet']
    output_json = ctx.obj['json']
    custom_dir = ctx.obj.get('wallet_dir')
    
    try:
        wallet_dir = get_wallet_dir(testnet, custom_dir)
        wallet = SignWallet()
        wallets = wallet.list_wallets()
        
        if output_json:
            print(json.dumps(wallets, indent=2))
            return
        
        if not wallets:
            console.print("[yellow]No wallets found[/yellow]")
            console.print("[dim]Create one with: pswallet create <name>[/dim]")
            return
        
        table = Table(title="💰 PiSecure Wallets")
        table.add_column("Name", style="cyan")
        table.add_column("Address", style="green")
        table.add_column("Balance", style="yellow", justify="right")
        table.add_column("Created", style="blue")
        
        for w in wallets:
            name = w.get('name', w.get('id', 'unknown'))
            address = w.get('address', 'unknown')
            balance = w.get('balance', 0)
            created = time.ctime(w.get('created', 0))
            
            table.add_row(
                name,
                address[:16] + "..." if len(address) > 16 else address,
                f"{balance:.2f}",
                created
            )
        
        console.print(table)
        
    except Exception as e:
        console.print(f"[red]Error: {e}[/red]")
        sys.exit(1)


@cli.command()
@click.argument('name')
@click.option('--display-name', help='Display name for wallet')
@click.pass_context
def create(ctx, name, display_name):
    """Create a new wallet"""
    testnet = ctx.obj['testnet']
    output_json = ctx.obj['json']
    custom_dir = ctx.obj.get('wallet_dir')
    
    try:
        wallet_dir = get_wallet_dir(testnet, custom_dir)
        
        # Ensure directory exists
        os.makedirs(wallet_dir, exist_ok=True)
        
        wallet = SignWallet()
        result = wallet.create_wallet(name, display_name or name)
        
        if output_json:
            print(json.dumps(result, indent=2))
            return
        
        if result.get('success'):
            console.print(f"[green]✅ Wallet created: {name}[/green]")
            console.print(f"[cyan]Address: {result.get('address')}[/cyan]")
            console.print(f"[yellow]Keep your keys safe![/yellow]")
        else:
            console.print(f"[red]❌ Error: {result.get('error')}[/red]")
            sys.exit(1)
            
    except Exception as e:
        console.print(f"[red]Error: {e}[/red]")
        sys.exit(1)


@cli.command()
@click.argument('name')
@click.pass_context
def show(ctx, name):
    """Show wallet details"""
    testnet = ctx.obj['testnet']
    output_json = ctx.obj['json']
    custom_dir = ctx.obj.get('wallet_dir')
    
    try:
        wallet_dir = get_wallet_dir(testnet, custom_dir)
        wallet = SignWallet()
        wallet_data = wallet.load_wallet(name)
        
        if 'error' in wallet_data:
            console.print(f"[red]❌ Wallet not found: {name}[/red]")
            sys.exit(1)
        
        if output_json:
            # Remove private key from JSON output
            safe_data = {k: v for k, v in wallet_data.items() if k != 'private_key'}
            print(json.dumps(safe_data, indent=2, default=str))
            return
        
        table = Table(title=f"🏦 Wallet: {name}")
        table.add_column("Property", style="cyan")
        table.add_column("Value", style="magenta")
        
        table.add_row("Wallet ID", wallet_data.get('wallet_id', 'unknown'))
        table.add_row("Name", wallet_data.get('name', 'unnamed'))
        table.add_row("Address", wallet_data.get('address', 'unknown'))
        table.add_row("Balance", f"{wallet_data.get('balance', 0):.2f} 314ST")
        table.add_row("Created", time.ctime(wallet_data.get('created_at', 0)))
        table.add_row("Transactions", str(len(wallet_data.get('transactions', []))))
        
        console.print(table)
        
    except Exception as e:
        console.print(f"[red]Error: {e}[/red]")
        sys.exit(1)


@cli.command()
@click.argument('address')
@click.pass_context
def balance(ctx, address):
    """Check balance of an address"""
    output_json = ctx.obj['json']
    
    try:
        # This would need blockchain access - simplified version
