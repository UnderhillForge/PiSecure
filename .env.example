# Copy to .env and edit. Never commit real keys.

PISECURE_VALIDATE_ONLY=1
PISECURE_TESTNET=0
PISECURE_DATA_DIR=/var/lib/pisecure
PISECURE_CONFIG_DIR=/etc/pisecure
PISECURE_API_HOST=0.0.0.0
PISECURE_API_PORT=3144
PISECURE_BOOTSTRAP_URL=https://bootstrap.pisecure.org
PISECURE_LOG_LEVEL=INFO
PISECURE_VALIDATOR_WALLET=

# Native daemon (pisecured)
PISECURED_HOST=0.0.0.0
PISECURED_PORT=3144
