#!/usr/bin/env python3
"""
PiSecure - Decentralized Security Framework for Raspberry Pi
============================================================

Main entry point for PiSecure blockchain node operations.
"""

import sys
import os
import time
import json
import threading
import psutil
import socket
from datetime import datetime
from collections import deque

try:
    # Try relative imports first (for package installation)
    from pisecure.core.blockchain import SignChain
    from pisecure.core.hardware import HardwareVerifier
    from pisecure.core.nat_traversal import node_discovery
    from pisecure.core.p2p_sync import P2PSyncManager
    from pisecure.core.consensus import get_consensus_engine
    from pisecure.network.discovery import PeerDiscovery
except ImportError:
    # Fall back to absolute imports (for direct execution)
    from core.blockchain import SignChain
    from core.hardware import HardwareVerifier
    from core.nat_traversal import node_discovery
    from core.p2p_sync import P2PSyncManager
    from core.consensus import get_consensus_engine
    from network.discovery import PeerDiscovery


class TextMiningInterface:
    """Simple text-based mining interface following miner-layout.txt specification"""

    def __init__(self, team_name=None, create_team=None, wallet=None):
        self.team_name = team_name
        self.create_team = create_team
        self.miner_wallet = wallet or self._load_miner_wallet()

        # Initialize PiSecure components
        self.blockchain = SignChain()
        self.hardware = HardwareVerifier()

        # Initialize syndicate support
        self.current_syndicate = None
        self.syndicate_coordinator = None
        self._init_syndicate_support()

        # Mining state
        self.mining_active = False
        self.mining_thread = None
        self.stop_event = threading.Event()
        self.mining_start_time = None

        # Stats tracking
        self.stats = {
            'blocks_mined': 0,
            'total_rewards': 0.0,
            'hashrate': 0.0,
            'session_rewards': 0.0,
            'session_blocks': 0,
            'last_block_time': None
        }

        # Miner output buffer
        self.miner_output = []
        self.max_output_lines = 10

    def _load_miner_wallet(self):
        """Load miner wallet address from config"""
        try:
            config_path = "/etc/pisecure/config.json"
            with open(config_path, 'r') as f:
                config = json.load(f)
            return config.get('mining', {}).get('wallet_address')
        except (FileNotFoundError, json.JSONDecodeError, KeyError):
            return None

    def _init_syndicate_support(self):
        """Initialize syndicate mining support"""
        try:
            self.consensus_engine = get_consensus_engine(self.blockchain, p2p_sync=None)

            if self.create_team:
                syndicate = self.consensus_engine.create_mining_syndicate(self.create_team, self.miner_wallet)
                self.current_syndicate = self.create_team
                self._log_output(f"🏢 Created syndicate '{self.create_team}'")
            elif self.team_name:
                success = self.consensus_engine.join_mining_syndicate(
                    self.team_name, self.miner_wallet, hashrate=1.0,
                    hardware_score=2.0, location="unknown"
                )
                if success:
                    self.current_syndicate = self.team_name
                    self._log_output(f"🤝 Joined syndicate '{self.team_name}'")
                else:
                    self._log_output(f"❌ Failed to join syndicate '{self.team_name}'")
        except Exception as e:
            self._log_output(f"⚠️ Syndicate initialization failed: {e}")

    def _log_output(self, message):
        """Add message to miner output buffer"""
        timestamp = datetime.now().strftime('%H:%M:%S')
        formatted = f"[{timestamp}] {message}"
        self.miner_output.append(formatted)
        if len(self.miner_output) > self.max_output_lines:
            self.miner_output.pop(0)

    def _get_bootstrap_info(self):
        """Get bootstrap server connection info"""
        try:
            # Try to get peer discovery info
            discovery_status = node_discovery.get_discovery_status()
            node_id = discovery_status.get('node_id', 'unknown')[:16]
            return f"bootstrap/{node_id}"
        except:
            return "bootstrap/unknown"

    def _get_current_block_info(self):
        """Get current block mining information"""
        try:
            chain_info = self.blockchain.get_chain_info()
            current_height = chain_info['blocks']
            difficulty = chain_info['difficulty']
            return current_height, difficulty
        except:
            return 0, 0

    def _calculate_average_hashrate(self):
        """Calculate average hashrate from session"""
        if self.stats['session_blocks'] > 0 and self.mining_start_time:
            elapsed = time.time() - self.mining_start_time
            if elapsed > 0:
                return self.stats['hashrate']  # Simplified - use current hashrate
        return 0.0

    def draw_interface(self):
        """Draw the mining interface following miner-layout.txt"""
        # Clear screen using system command - most reliable method
        import os
        os.system('clear')

        # Get current data
        version = "1.0.0"
        start_time = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        bootstrap_info = self._get_bootstrap_info()
        total_blocks = self.stats['blocks_mined']
        avg_hashrate = self._calculate_average_hashrate()
        total_rewards = self.stats['total_rewards']
        wallet_display = self.miner_wallet or "Not configured"
        if len(wallet_display) > 20:
            wallet_display = wallet_display[:17] + "..."

        current_block, difficulty = self._get_current_block_info()
        mining_start = "Active" if self.mining_active else "Not started"

        # Build output lines with proper formatting (left-justified)
        lines = []
        lines.append(f"PiSecure version {version} - Started {start_time}")
        lines.append("-" * 69)
        lines.append(f"Connected to {bootstrap_info}")

        # Add syndicate info if applicable
        if self.current_syndicate:
            lines.append(f"Syndicate: {self.current_syndicate} Share: Active")

        lines.append(f"Total Blocks: {total_blocks} Hash Avg: {avg_hashrate:.2f} KH/s Total Rewards: {total_rewards:.4f}")
        lines.append(f"Wallet: {wallet_display}")
        lines.append("-" * 69)
        lines.append(f"Block: {current_block} Difficulty: {difficulty} Started: {mining_start}")
        lines.append("Miner Output:")

        # Add miner output lines
        for line in self.miner_output[-self.max_output_lines:]:
            lines.append(f"  {line}")

        # Fill remaining space
        remaining = self.max_output_lines - len(self.miner_output)
        for _ in range(max(0, remaining)):
            lines.append("")

        lines.append("-" * 69)

        # Footer controls
        status = "D" if self.mining_active else "E"
        status_text = "Disable" if self.mining_active else "Enable"
        lines.append(f"[{status}] {status_text} [R] Restart [Q] Quit")

        # Print all lines at once to ensure atomic update
        output = "\n".join(lines)
        print(output, end="", flush=True)

    def start_mining(self):
        """Start the mining process"""
        if self.mining_active:
            self._log_output("Mining already active")
            return

        # Hardware verification
        try:
            result = self.hardware.verify_mining_eligibility()
            if not result['eligible']:
                self._log_output(f"Hardware verification failed: {result.get('error', 'Unknown error')}")
                return
        except Exception as e:
            self._log_output(f"Hardware check failed: {e}")
            return

        self._log_output("Starting mining session...")
        self.mining_active = True
        self.mining_start_time = time.time()
        self.stats['session_blocks'] = 0
        self.stats['session_rewards'] = 0.0

        self.mining_thread = threading.Thread(target=self._mining_worker, daemon=True)
        self.mining_thread.start()

    def stop_mining(self):
        """Stop the mining process"""
        if not self.mining_active:
            self._log_output("Mining not active")
            return

        self._log_output("Stopping mining...")
        self.mining_active = False
        self.stop_event.set()

        if self.mining_thread and self.mining_thread.is_alive():
            self.mining_thread.join(timeout=5)

    def restart_mining(self):
        """Restart the mining process"""
        self._log_output("Restarting mining...")
        self.stop_mining()
        time.sleep(1)  # Brief pause
        self.start_mining()

    def _mining_worker(self):
        """Background mining worker"""
        self._log_output("Mining worker started")

        while not self.stop_event.is_set():
            try:
                pending_count = len(self.blockchain.pending_transactions)

                if pending_count > 0:
                    self._log_output(f"Found {pending_count} pending transaction(s)")

                    start_time = time.time()
                    block = self.blockchain.mine_pending_transactions(self.miner_wallet, verbose=False)
                    mining_duration = time.time() - start_time

                    if block:
                        # Calculate hashrate
                        nonce = getattr(block, 'nonce', 0)
                        if nonce > 0:
                            self.stats['hashrate'] = max(0.1, nonce / max(1, mining_duration)) / 1000

                        self._log_output(f"🎉 BLOCK #{block.index} MINED!")
                        self._log_output(f"   Hash: {block.hash[:32]}...")
                        self._log_output(f"   Nonce: {nonce:,} Time: {mining_duration:.2f}s")
                        self._log_output(f"   Rate: {self.stats['hashrate']:.1f} KH/s")

                        self.stats['blocks_mined'] += 1
                        self.stats['session_blocks'] += 1
                        self.stats['last_block_time'] = time.time()

                        # Check for rewards
                        reward_txs = [tx for tx in block.transactions if tx.get('type') == 'mining_reward']
                        if reward_txs:
                            reward_amount = reward_txs[0].get('amount', 0)
                            self.stats['total_rewards'] += reward_amount
                            self.stats['session_rewards'] += reward_amount
                            self._log_output(f"💰 Reward: +{reward_amount:.2f} tokens")
                    else:
                        time.sleep(2)
                else:
                    time.sleep(5)  # No pending transactions

            except Exception as e:
                self._log_output(f"Mining error: {e}")
                time.sleep(5)

        self._log_output("Mining worker stopped")

    def run(self):
        """Run the mining interface"""
        import select
        import tty
        import termios

        # Save terminal settings
        old_settings = termios.tcgetattr(sys.stdin)

        try:
            # Set terminal to raw mode
            tty.setraw(sys.stdin.fileno())

            self._log_output("PiSecure mining interface started")
            self._log_output("Press 'E' to start mining, 'D' to stop, 'R' to restart, 'Q' to quit")

            while True:
                self.draw_interface()

                # Wait for keyboard input with timeout
                if select.select([sys.stdin], [], [], 1.0)[0]:
                    key = sys.stdin.read(1).lower()

                    if key == 'e' and not self.mining_active:
                        self.start_mining()
                    elif key == 'd' and self.mining_active:
                        self.stop_mining()
                    elif key == 'r':
                        self.restart_mining()
                    elif key == 'q':
                        if self.mining_active:
                            self.stop_mining()
                        break

        finally:
            # Restore terminal settings
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)





def main():
    """Main entry point"""
    if len(sys.argv) < 2:
        print("PiSecure - Decentralized Security Framework")
        print()
        print("Usage:")
        print("  pisecure.py status          - Show blockchain status")
        print("  pisecure.py wallet          - Show wallet information")
        print("  pisecure.py mine           - Start mining")
        print("  pisecure.py mine --team NAME - Join mining team")
        print("  pisecure.py dashboard      - Start web dashboard")
        print("  pisecure.py create-wallet  - Create new wallet")
        print()
        print("Team Mining:")
        print("  --team NAME        Join existing team")
        print("  --create-team NAME Create new team")
        print()
        print("For full CLI: python -m pisecure.cli")
        return

    command = sys.argv[1]

    if command == "status":
        os.system("python -m pisecure.cli status")
    elif command == "wallet":
        os.system("python -m pisecure.cli wallet")
    elif command == "mine":
        # Parse mining arguments
        team_name = None
        create_team = None
        wallet = None

        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--team" and i + 1 < len(sys.argv):
                team_name = sys.argv[i + 1]
                i += 2
            elif sys.argv[i] == "--create-team" and i + 1 < len(sys.argv):
                create_team = sys.argv[i + 1]
                i += 2
            elif sys.argv[i] == "--wallet" and i + 1 < len(sys.argv):
                wallet = sys.argv[i + 1]
                i += 2
            else:
                i += 1

        # Use CLI mining interface instead
        os.system(f"python -m pisecure.cli mine --wallet '{wallet}'" if wallet else "python -m pisecure.cli mine")
    elif command == "dashboard":
        os.system("python dashboard/web/minimal_dashboard.py")
    elif command == "create-wallet":
        wallet_name = input("Wallet name (default): ") or "default"
        wallet_display = input("Display name: ") or "PiSecure Wallet"
        os.system(f"python -m pisecure.cli create-wallet '{wallet_name}' --display-name '{wallet_display}'")
    else:
        print(f"Unknown command: {command}")
        print("Use 'pisecure.py' without arguments to see available commands")

if __name__ == "__main__":
    main()