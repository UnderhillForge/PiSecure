#!/usr/bin/env python3
"""Entry point for validator bucket CLI (delegates to validator-purse script)."""
import pathlib
import runpy
import sys


def main():
    target = pathlib.Path(__file__).with_name("validator-purse")
    runpy.run_path(target, run_name="__main__")


if __name__ == "__main__":
    sys.exit(main())
