#!/usr/bin/env python3
"""
PiSecure Validator Bucket Manager - Link Wallets & Auto-Sweep

Utility to manage pisecured validator rewards bucket:
- Check balance
- View reward history
- Link to wallet
- Configure auto-sweep
- View statistics
"""

import json
import sys
import argparse
from pathlib import Path
from datetime import datetime
from rich.console import Console
from rich.table import Table
from rich.panel import Panel

console = Console()
DEFAULT_BUCKET_PATH = Path.home() / ".pisecure" / "validator_bucket.json"


def resolve_bucket_path(args) -> Path:
    """Determine bucket file path."""
    if getattr(args, "bucket_path", None):
        return args.bucket_path
    base = Path.home() / (".pisecure-testnet" if args.testnet else ".pisecure")
    return base / "validator_bucket.json"

def load_bucket(path):
    if not path.exists():
        console.print(f"[red]Bucket not found at {path}[/red]")
        console.print("[yellow]Hint: Run pisecured first to create the bucket[/yellow]")
        return None
    try:
        with open(path, 'r') as f:
            return json.load(f)
    except Exception as e:
        console.print(f"[red]Failed to load bucket: {e}[/red]")
        return None

def save_bucket(path, data):
    try:
        with open(path, 'w') as f:
            json.dump(data, f, indent=2)
        return True
    except Exception as e:
        console.print(f"[red]Failed to save bucket: {e}[/red]")
        return False

def format_timestamp(ts):
    return datetime.fromtimestamp(ts).strftime('%Y-%m-%d %H:%M:%S')

def cmd_balance(args):
    bucket_path = resolve_bucket_path(args)
    bucket = load_bucket(bucket_path)
    if not bucket:
        return 1
    balance = bucket.get('total_balance', 0.0)
    lifetime = bucket.get('lifetime_earned', 0.0)
    withdrawn = bucket.get('lifetime_withdrawn', 0.0)
    blocks = bucket.get('blocks_validated', 0)
    linked = bucket.get('linked_wallet_address', '')
    wallet_info = f"\n[cyan]Linked Wallet:[/cyan] [green]{linked[:40]}[/green]" if linked else ""
    panel = Panel(
        f"[cyan]Current Balance:[/cyan] [green]{balance:.6f} 314ST[/green]\n"
        f"[cyan]Lifetime Earned:[/cyan] {lifetime:.6f} 314ST\n"
        f"[cyan]Lifetime Withdrawn:[/cyan] {withdrawn:.6f} 314ST\n"
        f"[cyan]Blocks Validated:[/cyan] {blocks}{wallet_info}",
        title="💰 Validator Bucket Status",
        border_style="green"
    )
    console.print(panel)
    if balance > 0 and not linked:
        console.print(f"\n[yellow]💡 Link wallet to enable auto-accumulation:[/yellow] [cyan]validator-bucket link YOUR_WALLET[/cyan]")
    return 0

def cmd_link(args):
    bucket_path = resolve_bucket_path(args)
    bucket = load_bucket(bucket_path)
    if not bucket:
        return 1
    if not args.wallet:
        console.print("[red]Error: wallet address required[/red]")
        return 1
    old_wallet = bucket.get('linked_wallet_address', '')
    bucket['linked_wallet_address'] = args.wallet
    bucket['last_updated'] = int(datetime.now().timestamp())
    if save_bucket(bucket_path, bucket):
        if old_wallet:
            console.print(f"[yellow]Changed linked wallet:[/yellow] {old_wallet[:40]} → {args.wallet[:40]}")
        else:
            console.print(f"[green]✅ Linked wallet:[/green] {args.wallet}")
        panel = Panel(
            f"[cyan]Next:[/cyan] Restart pisecured for auto-accumulation\n"
            f"[cyan]Command:[/cyan] [green]pisecured --validator-wallet {args.wallet}[/green]",
            title="🔗 Wallet Linked",
            border_style="green"
        )
        console.print(panel)
        return 0
    return 1

def cmd_auto_sweep(args):
    bucket_path = resolve_bucket_path(args)
    bucket = load_bucket(bucket_path)
    if not bucket:
        return 1
    linked = bucket.get('linked_wallet_address', '')
    if not linked:
        console.print("[red]Error: No wallet linked first![/red]")
        return 1
    threshold = args.threshold if args.threshold else 0.0
    bucket['auto_sweep_enabled'] = True
    bucket['auto_sweep_threshold'] = threshold
    bucket['last_updated'] = int(datetime.now().timestamp())
    if save_bucket(bucket_path, bucket):
        if threshold > 0:
            console.print(f"[green]✅ Auto-sweep:[/green] Accumulates until {threshold:.6f} 314ST threshold")
        else:
            console.print(f"[green]✅ Auto-sweep:[/green] Sweeps immediately on each reward")
        return 0
    return 1

def cmd_history(args):
    bucket_path = resolve_bucket_path(args)
    bucket = load_bucket(bucket_path)
    if not bucket:
        return 1
    rewards = bucket.get('recent_rewards', [])
    if not rewards:
        console.print("[yellow]No rewards recorded yet[/yellow]")
        return 0
    limit = args.limit if args.limit else len(rewards)
    rewards_to_show = rewards[:limit]
    table = Table(title=f"📜 Recent Validator Rewards (last {len(rewards_to_show)})")
    table.add_column("Block", style="cyan")
    table.add_column("Amount", style="green", justify="right")
    table.add_column("Validators", justify="center")
    table.add_column("Time", style="dim")
    for reward in rewards_to_show:
        table.add_row(str(reward['block_height']), f"{reward['amount']:.6f}", str(reward['validator_count']), format_timestamp(reward['timestamp']))
    console.print(table)
    total = sum(r['amount'] for r in rewards_to_show)
    console.print(f"\n[cyan]Total shown:[/cyan] [green]{total:.6f} 314ST[/green]")
    return 0

def cmd_stats(args):
    bucket_path = resolve_bucket_path(args)
    bucket = load_bucket(bucket_path)
    if not bucket:
        return 1
    created = format_timestamp(bucket.get('created_at', 0))
    percentage = bucket.get('rewards_percentage', 0.01)
    linked_wallet = bucket.get('linked_wallet_address', '')
    auto_sweep = bucket.get('auto_sweep_enabled', False)
    auto_threshold = bucket.get('auto_sweep_threshold', 0.0)
    rewards = bucket.get('recent_rewards', [])
    blocks = bucket.get('blocks_validated', 0)
    lifetime = bucket.get('lifetime_earned', 0.0)
    avg_per_block = lifetime / blocks if blocks > 0 else 0.0
    wallet_status = f"[green]✅ {linked_wallet[:40]}[/green]" if linked_wallet else "[yellow]Not linked[/yellow]"
    sweep_status = f"[green]✅ @ {auto_threshold:.6f} 314ST[/green]" if auto_sweep and linked_wallet else "[yellow]Disabled[/yellow]"
    stats_text = f"""[bold cyan]Configuration:[/bold cyan]
[cyan]Rewards %:[/cyan] {percentage * 100:.2f}%
[cyan]Linked Wallet:[/cyan] {wallet_status}
[cyan]Auto-Sweep:[/cyan] {sweep_status}

[bold cyan]Performance:[/bold cyan]
[cyan]Blocks Validated:[/cyan] {blocks}
[cyan]Avg/Block:[/cyan] {avg_per_block:.6f} 314ST
[cyan]Lifetime Earned:[/cyan] {lifetime:.6f} 314ST

[bold cyan]Balance:[/bold cyan]
[cyan]Current:[/cyan] [green]{bucket.get('total_balance', 0.0):.6f} 314ST[/green]
[cyan]Withdrawn:[/cyan] {bucket.get('lifetime_withdrawn', 0.0):.6f} 314ST"""
        panel = Panel(stats_text, title="📊 Bucket Statistics", border_style="cyan")
    console.print(panel)
    return 0

def main():
        parser = argparse.ArgumentParser(description="Manage pisecured validator bucket", formatter_class=argparse.RawDescriptionHelpFormatter, epilog="""
Examples:
    validator-bucket balance                          # Check balance
    validator-bucket link YOUR_WALLET                 # Link wallet
    validator-bucket auto-sweep YOUR_WALLET 0.5       # Auto-sweep at 0.5 314ST
    validator-bucket auto-sweep YOUR_WALLET 0         # Auto-sweep every reward
    validator-bucket history --limit 20               # Last 20 rewards
    validator-bucket stats                            # Detailed stats
    """)
        parser.add_argument('--bucket-path', type=Path, default=None, help='Path to validator_bucket.json')
        parser.add_argument('--testnet', action='store_true', help='Use testnet bucket')
    subparsers = parser.add_subparsers(dest='command')
    subparsers.add_parser('balance').set_defaults(func=cmd_balance)
    sp = subparsers.add_parser('link')
    sp.add_argument('wallet')
    sp.set_defaults(func=cmd_link)
    sp = subparsers.add_parser('auto-sweep')
    sp.add_argument('wallet')
    sp.add_argument('threshold', type=float, nargs='?', default=0.0)
    sp.set_defaults(func=cmd_auto_sweep)
    sp = subparsers.add_parser('history')
    sp.add_argument('--limit', type=int)
    sp.set_defaults(func=cmd_history)
    subparsers.add_parser('stats').set_defaults(func=cmd_stats)
    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 1
    return args.func(args)

if __name__ == '__main__':
    sys.exit(main())
